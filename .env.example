OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Where room state (rooms.json) is persisted. On Railway, point this at a
# mounted Volume's path so it survives redeploys (e.g. /data).
DATA_DIR=

# Password for the owner-only stats page at /stats (daily visitors, players, games).
# Leave empty to use the temporary hardcoded fallback in server/stats.js.
STATS_PASSWORD=

# Postgres for accounts + lifetime game history (server/db.js). On Railway, add a
# Postgres service and reference its DATABASE_URL here. Leave empty to run without
# accounts - every game still works, results just aren't recorded.
DATABASE_URL=

# OAuth "Web application" client ID from Google Cloud Console (APIs & Services ->
# Credentials). Add your site's origin (and http://localhost:3000 for dev) under
# "Authorized JavaScript origins". Leave empty to hide Google sign-in.
GOOGLE_CLIENT_ID=

# Comma-separated Google account email(s) allowed into the admin page at /admin.
# Sign in with that Google account on the site first. Leave empty = nobody is admin.
ADMIN_EMAILS=

# Dev/testing only: make every Warfront match this many ms long (e.g. 60000), so a full
# match reaches the game-over screen quickly. Leave empty in production.
WF_DEV_MATCH_MS=
